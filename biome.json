{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "maplibre-gl",
                      "maplibre-gl/**"
                    ],
                    "message": "packages/domain harus murni: tanpa React atau MapLibre (CONTRIBUTING.md)."
                  },
                  {
                    "group": ["@indoor/**"],
                    "message": "packages/domain tidak bergantung pada paket lain di repo."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/routing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "maplibre-gl",
                      "maplibre-gl/**"
                    ],
                    "message": "packages/routing harus murni: tanpa React atau MapLibre (CONTRIBUTING.md)."
                  },
                  {
                    "group": ["@indoor/demo", "@indoor/map-core", "@indoor/ui"],
                    "message": "packages/routing hanya boleh bergantung pada @indoor/domain."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/demo/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "maplibre-gl",
                      "maplibre-gl/**"
                    ],
                    "message": "packages/demo hanya berisi data: tanpa React atau MapLibre."
                  },
                  {
                    "group": ["@indoor/routing", "@indoor/map-core", "@indoor/ui"],
                    "message": "packages/demo hanya boleh bergantung pada @indoor/domain."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/map-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@indoor/demo"],
                    "message": "packages/map-core tidak mengakses data; terima data lewat argumen."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
